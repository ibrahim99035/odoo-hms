<odoo>
    <template id="report_patient_status">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="patient">
                <t t-call="web.external_layout">
                    <div class="page">

                        <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:20px;">
                            <h2 style="color:#8B0000; font-weight:bold;">Patient Status Report</h2>
                            <t t-if="patient.image">
                                <img t-att-src="'data:image/png;base64,' + patient.image.decode('utf-8')"
                                     style="width:120px; height:120px; object-fit:cover;"/>
                            </t>
                        </div>

                        <!-- Two-column info -->
                        <div style="display:flex; gap:40px; margin-bottom:30px;">
                            <div style="flex:1;">
                                <p><strong>Name:</strong> <t t-out="patient.first_name"/> <t t-out="patient.last_name"/></p>
                                <p><strong>Age:</strong> <t t-out="patient.age"/></p>
                                <p><strong>Department:</strong> <t t-out="patient.department_id.name or 'N/A'"/></p>
                                <p>
                                    <strong>Doctors:</strong>
                                    <t t-out="', '.join(patient.doctor_ids.mapped('first_name')) or 'N/A'"/>
                                </p>
                            </div>
                            <div style="flex:1;">
                                <p><strong>Birth date:</strong> <t t-out="patient.birth_date"/></p>
                                <p><strong>PCR:</strong> <t t-out="patient.cr_ratio"/></p>
                                <p><strong>Blood Type:</strong> <t t-out="dict(patient._fields['blood_type'].selection).get(patient.blood_type, 'N/A')"/></p>
                                <p><strong>Email:</strong> <t t-out="patient.email"/></p>
                            </div>
                        </div>

                        <h4 style="text-align:center; color:#8B0000;">Log History</h4>
                        <table class="table table-bordered" style="width:100%;">
                            <thead style="background-color:#b0c4de;">
                                <tr>
                                    <th>User</th>
                                    <th>Date</th>
                                    <th>Info</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="patient.log_ids" t-as="log">
                                    <tr>
                                        <td><t t-out="log.created_by.name"/></td>
                                        <td><t t-out="log.date"/></td>
                                        <td><t t-out="log.description"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_patient_status" model="ir.actions.report">
        <field name="name">Patient Status Report</field>
        <field name="model">hms.patient</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hms.report_patient_status</field>
        <field name="report_file">hms.report_patient_status</field>
        <field name="binding_model_id" ref="model_hms_patient"/>
        <field name="binding_type">report</field>
    </record>
</odoo>